# =====================================================================
# JobHunter 环境变量模板
# 使用方法: cp .env.example .env  然后按注释填写真实值
# 说明: 运行时也可在「策略实验室 → 系统底层配置」页面热更新（写入
#       backend/common/data/settings.json，优先级高于本文件）
# =====================================================================

# ---------------------------------------------------------------------
# 应用基础与安全（服务标识 / CORS / 初始管理员）
# PROJECT_NAME: 服务标题（接口文档名，默认 JobHunter）
# ENVIRONMENT: 运行环境标识 local / staging / production
# SECRET_KEY: 后端 JWT 签名密钥（务必改成任意长随机串，切勿沿用示例值）
# FRONTEND_HOST: 前端访问地址（参与后端 CORS 允许列表；本仓库前端默认跑在 http://localhost:3000）
# BACKEND_CORS_ORIGINS: 额外 CORS 允许源，逗号分隔（如 http://localhost:3000,https://your.domain；修改后需重启后端）
# FIRST_SUPERUSER / FIRST_SUPERUSER_PASSWORD: 初始管理员邮箱与密码（首次登录后请立即改密）
# ---------------------------------------------------------------------
PROJECT_NAME=
ENVIRONMENT=local
SECRET_KEY=
FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# ---------------------------------------------------------------------
# 飞书多维表格（核心依赖：职位管道/简历/面经同步全靠它，必填）
# ---------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID_JOBS=
FEISHU_TABLE_ID_RESUMES=
FEISHU_TABLE_ID_INTERVIEW_REPORTS=
FEISHU_TABLE_ID_INTERVIEW_SUMMARY=
FEISHU_TABLE_ID_INTERVIEW_REAL=
# 飞书消息接收人（可选：用于招聘平台登录失效告警、任务战报通知；个人以 ou_ 开头，群聊以 oc_ 开头）
FEISHU_ALERT_RECEIVE_ID=
# ChatOps 审批门禁白名单（可选：open_id 逗号分隔；留空=群内全员可点「放行/批准」等审批动作。
# 多人部署/开源场景强烈建议配置，仅名单内用户可触发投递审批。open_id 可从机器人收到消息事件的 sender_id 获取）
FEISHU_APPROVER_OPEN_IDS=


# ---------------------------------------------------------------------
# 主 LLM（对话/改写/评估，必填；兼容 OpenAI 协议的任意服务均可）
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
VISION_MODEL=

# ---------------------------------------------------------------------
# 清洗专用 LLM（岗位数据清洗/结构化，可复用主 LLM：USE_MAIN_LLM_FOR_CLEANER=true）
# ---------------------------------------------------------------------
CLEANER_LLM_API_KEY=
CLEANER_LLM_BASE_URL=
CLEANER_LLM_MODEL=
CLEANER_VISION_MODEL=
USE_MAIN_LLM_FOR_CLEANER=

# ---------------------------------------------------------------------
# 通义千问（Embedding / 备用模型）
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# 联网搜索（可选：企业背调 / Tavily 探针）
# ---------------------------------------------------------------------
SERPER_API_KEY=
TAVILY_API_KEY=

# ---------------------------------------------------------------------
# 火山引擎语音（可选：语音识别 ASR）
# ---------------------------------------------------------------------
VOLC_ASR_APPID=
VOLC_ASR_TOKEN=
VOLC_ASR_RESOURCE_ID=

# ---------------------------------------------------------------------
# 高德地图（可选：通勤距离评估）
# ---------------------------------------------------------------------
AMAP_API_KEY=
AMAP_BASE_URL=

# ---------------------------------------------------------------------
# 高级可选（一般无需填写）
# INTERVIEW_SCRAPER_PATH: 面试 Copilot 依赖的外部 interview_scraper 项目路径，
#                         默认假设与本仓库同级，功能不用可不填
# ANALYTICS_DB_PATH:      数据分析看板的 SQLite 路径覆盖
# ---------------------------------------------------------------------
# INTERVIEW_SCRAPER_PATH=
# ANALYTICS_DB_PATH=

# ---------------------------------------------------------------------
# 公网直达域名（可选：面试锦囊 / 简历 PDF 直达链接回写飞书）
# 需要一个公网可达的本机域名（如内网穿透），例如 https://api.example.com
# ---------------------------------------------------------------------
TUNNEL_DOMAIN=

# ---------------------------------------------------------------------
# 主项目外部主库（可选：特殊部署时指向主 DB；默认用本仓库 backend/data/job_hunter.db）
# ---------------------------------------------------------------------
# MAIN_PROJECT_DB=
